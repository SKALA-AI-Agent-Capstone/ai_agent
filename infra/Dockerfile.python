FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /usr/local/bin/uv
WORKDIR /app
# Tesseract is the OCR fallback; libgl1, libglib2.0-0 and libgomp1 are what PaddleOCR needs at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-kor tesseract-ocr-eng \
    libgl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY services/agent ./services/agent
COPY services/business-mcp ./services/business-mcp
COPY services/rag-mcp ./services/rag-mcp
# Source registry for the corpus batch (rag-ingest). PDFs come from the mounted ./data folder or are downloaded.
COPY resources/reference-sources.json ./registry/reference-sources.json
RUN uv sync --all-packages --frozen --no-dev
RUN useradd --create-home --uid 10001 capstone
USER capstone
ENV PYTHONUNBUFFERED=1 PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# Download the PaddleOCR detection and Korean recognition models at build time, not on the first review.
RUN uv run --no-sync python -c "from capstone_agent.paddle_ocr import engine; engine()"
CMD ["uv", "run", "--no-sync", "capstone-agent"]
